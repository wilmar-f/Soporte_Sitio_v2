<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <style>
    @page { size: letter; }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    html, body { height: 100%; }

    body {
      font-family: Calibri, 'Segoe UI', Arial, sans-serif;
      font-size: 11pt;
      color: #000;
      background: #fff;
      width: 100%;
      height: 100%;
      margin: 0;
      padding: 0;
    }

    .pdf-doc {
      width: 100%;
      height: 100%;
      padding-top: 4px;
      display: flex;
      flex-direction: column;
    }

    .header-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 8px;
      gap: 8px;
      flex-shrink: 0;
    }
    .header-col-left {
      width: 18%;
      flex-shrink: 0;
      display: flex;
      align-items: center;
    }
    .header-col-left img {
      height: 36px;
      max-width: 84px;
      object-fit: contain;
    }
    .header-col-center {
      flex: 1;
      text-align: center;
      padding: 0 8px;
    }
    .header-col-right {
      width: 25%;
      flex-shrink: 0;
      text-align: right;
      font-family: Arial, Helvetica, sans-serif;
      font-size: 12pt;
      line-height: 1.45;
    }
    .header-formato-titulo {
      font-family: Arial, Helvetica, sans-serif;
      font-size: 12pt;
      font-weight: 700;
      color: #000;
      line-height: 1.3;
    }
    .header-formato-subtitulo {
      font-family: Arial, Helvetica, sans-serif;
      font-size: 12pt;
      font-weight: 700;
      color: #8E8E8E;
      line-height: 1.3;
    }

    .evidencias-grid {
      flex: 1;
      min-height: 0;
      display: flex;
      flex-direction: column;
      gap: 8px;
      padding: 4px 0 0;
    }
    .evidencia-item {
      flex: 1;
      min-height: 0;
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .evidencia-item img {
      max-width: 100%;
      max-height: 100%;
      width: auto;
      height: auto;
      object-fit: contain;
      display: block;
    }
  </style>
</head>
<body>
<div class="pdf-doc">

<div class="header-row">
  <div class="header-col-left">
    <img src="{{logo1Src}}" alt="Corbeta">
  </div>
  <div class="header-col-center">
    <div class="header-formato-titulo">Formato</div>
    <div class="header-formato-subtitulo">DIAGNÓSTICO DE ACTIVOS SOPORTE EN SITIO</div>
  </div>
  <div class="header-col-right">
    <strong>Código:</strong> FR-BAI09.11<br>
    <strong>Versión:</strong> 1
  </div>
</div>

<div class="evidencias-grid">
  {{#each imagenes}}
  {{{this}}}
  {{/each}}
</div>

</div>
</body>
</html>
